# DearMe production environment template
# Copy to .env.production.local (or set in your hosting platform's env panel).
# Validate with: pnpm dearme:prod-ready
#
# Doctrine: every key here is a REUSE — DearMe does not run its own
# embeddings model, transactional email, lifecycle email, analytics,
# support inbox, etc. We pay third parties to NOT build those systems.
#
# DO NOT add @aws-sdk/client-bedrock or any direct LLM SDK. See
# memory `project-aws-bedrock-incident-2026-05-02`.

# =========================================================================
# Core (REQUIRED)
# =========================================================================

# Public URL the landing page + Stripe success_url + DNS point at.
# Must be HTTPS in production.
DEARME_PUBLIC_URL=https://dearme.app

# Postgres connection string. Get from Neon (https://console.neon.tech)
# or Supabase (https://supabase.com/dashboard) or Railway.
DATABASE_URL=postgres://user:pass@host:5432/dearme

# =========================================================================
# Database backups - cron-friendly pg_dump to S3-compatible storage
# Run with: pnpm dearme:db-backup
# =========================================================================

DEARME_DB_BACKUP_BUCKET=dearme-prod-db-backups
DEARME_DB_BACKUP_PREFIX=prod/postgres
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
# Backblaze B2 example: https://s3.<region>.backblazeb2.com
DEARME_DB_BACKUP_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
DEARME_DB_BACKUP_REGION=auto
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# =========================================================================
# Stripe — payments, subscriptions, Customer Portal
# Get from: https://dashboard.stripe.com/apikeys
# =========================================================================

# sk_live_* in prod, sk_test_* in staging
DEARME_STRIPE_SECRET_KEY=sk_live_...

# whsec_*. Endpoint: https://dearme.app/v1/dearme/checkout/webhook
# Events: checkout.session.completed, invoice.paid, customer.subscription.deleted
# Get from: https://dashboard.stripe.com/webhooks
DEARME_STRIPE_WEBHOOK_SECRET=whsec_...

# Create one Stripe Product "DearMe Beta", $29/month recurring subscription.
# Copy the price ID here (price_*).
# https://dashboard.stripe.com/products
DEARME_STRIPE_PRICE_BETA=price_...

# =========================================================================
# Voyage AI — voice fingerprint embeddings
# Get from: https://dash.voyageai.com/api-keys
# Cost: ~$0.05 per 1M tokens (voyage-3-lite). Effectively free at our scale.
# =========================================================================

DEARME_VOICE_VOYAGE_API_KEY=pa-...
DEARME_VOICE_SEMANTIC_SCORER=voyage

# =========================================================================
# Resend — transactional email (account / receipt / approval)
# Get from: https://resend.com/api-keys
# Domain: add dearme.app and verify the 4 DNS records (SPF/DKIM/MX/DMARC).
# Free tier: 100 emails/day, 3000/month.
# =========================================================================

DEARME_EMAIL_RESEND_API_KEY=re_...
DEARME_EMAIL_FROM=team@dearme.app
DEARME_EMAIL_REPLY_TO=peter@dearme.app

# =========================================================================
# Loops — lifecycle email (welcome / trial-ending / dunning / win-back)
# Get from: https://loops.so/settings/api
# Set up these event names: dearme_signup, dearme_first_payment,
# dearme_cancelled, dearme_renewal, dearme_trial_ending.
# Free tier: 1000 contacts.
# =========================================================================

DEARME_LOOPS_API_KEY=...

# =========================================================================
# PostHog — product analytics + feature flags
# Get from: https://us.posthog.com/project/settings
# Free tier: 1M events/month. Self-host if you outgrow.
# =========================================================================

# Public (exposed in browser bundle)
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-side
DEARME_POSTHOG_KEY=phc_...

# =========================================================================
# Sentry — error monitoring
# Browser DSN is public; auth token/org/project are CI-only for source maps.
# =========================================================================

DEARME_SENTRY_DSN=https://public@example.ingest.sentry.io/project
VITE_DEARME_SENTRY_DSN=https://public@example.ingest.sentry.io/project
DEARME_SENTRY_ENVIRONMENT=production
VITE_DEARME_SENTRY_ENVIRONMENT=production
DEARME_SENTRY_TRACES_SAMPLE_RATE=0
VITE_DEARME_SENTRY_TRACES_SAMPLE_RATE=0

# =========================================================================
# Google OAuth — self-serve signin
# Get from: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://dearme.app/api/auth/callback/google
# =========================================================================

DEARME_GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
DEARME_GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# =========================================================================
# Plain — support inbox
# Get from: https://app.plain.com/settings/api-keys
# Webhook endpoint: https://dearme.app/v1/dearme/support/webhook
# Free tier: 100 conversations/month.
# =========================================================================

DEARME_PLAIN_API_KEY=...
DEARME_PLAIN_WEBHOOK_SECRET=...

# =========================================================================
# Owner-supplied facts for live channel proof (Peter fills these)
# Use: pnpm dearme:next-proof -- --target <name>
# =========================================================================

# LinkedIn partner messages endpoint (from your chosen partner: Expandi /
# Closely / PhantomBuster / direct Marketing Developer Platform).
# DEARME_LINKEDIN_DM_MESSAGES_URL=https://api.partner.com/v1/messages

# LinkedIn URN of the first smoke recipient (your alt account / co-founder).
# DEARME_LINKEDIN_DM_SMOKE_RECIPIENT_URN=urn:li:person:abc123

# iMessage recipient for the OpenClaw gateway smoke (phone or Apple ID).
# DEARME_OPENCLAW_IMESSAGE_SMOKE_RECIPIENT=+15551234567

# =========================================================================
# Optional providers (configure when you're ready)
# =========================================================================

# X (Twitter) OAuth — for post_x dispatcher
# https://developer.twitter.com/en/portal/projects-and-apps
# DEARME_X_OAUTH_CLIENT_ID=...
# DEARME_X_OAUTH_CLIENT_SECRET=...

# Meta Ads — for create_meta_campaign dispatcher
# https://developers.facebook.com/apps
# DEARME_META_GRAPH_BASE_URL=https://graph.facebook.com/v21.0
# DEARME_META_ACCESS_TOKEN=...

# Better Stack — uptime monitoring (https://betterstack.com/)
# No code config; just point a monitor at https://dearme.app/readyz

# =========================================================================
# OpenClaw gateway (for users running the DearMe OpenClaw plugin)
# If you're testing on your own machine, set DEARME_USE_LOCAL_OPENCLAW_CONFIG=1
# and the gateway URL/auth come from ~/.openclaw/openclaw.json automatically.
# =========================================================================

# DEARME_USE_LOCAL_OPENCLAW_CONFIG=1
# DEARME_OPENCLAW_GATEWAY_URL=https://gateway.internal:18789
# DEARME_OPENCLAW_GATEWAY_AUTH=Bearer ...

# =========================================================================
# Cost guards (PRODUCTION DEFAULTS — DO NOT REMOVE)
# =========================================================================

# Block any DearMe code path from instantiating Bedrock clients.
# Set DEARME_DISABLE_BEDROCK=1 to fail-closed if a dependency tries.
DEARME_DISABLE_BEDROCK=1

# Per-customer USD daily/monthly cap defaults (micros: 1 USD = 1_000_000)
# Override via the dearme_cost_caps table per company.
DEARME_DEFAULT_DAILY_CAP_USD_MICROS=5000000
DEARME_DEFAULT_MONTHLY_CAP_USD_MICROS=100000000
