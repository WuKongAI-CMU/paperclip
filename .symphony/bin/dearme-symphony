#!/usr/bin/env bash
set -euo pipefail

DEARME_ROOT="${DEARME_ROOT:-/Users/peter/dearme}"
SYMPHONY_BIN="${SYMPHONY_BIN:-/Users/peter/.local/bin/symphony}"
WORKFLOW="${DEARME_SYMPHONY_WORKFLOW:-$DEARME_ROOT/.symphony/WORKFLOW.md}"
SMOKE_WORKFLOW="${DEARME_SYMPHONY_SMOKE_WORKFLOW:-$DEARME_ROOT/.symphony/WORKFLOW.local-smoke.md}"
LOGS_ROOT="${DEARME_SYMPHONY_LOGS_ROOT:-$DEARME_ROOT/.symphony/logs}"
RUN_DIR="${DEARME_SYMPHONY_RUN_DIR:-$DEARME_ROOT/.symphony/run}"
PID_FILE="$RUN_DIR/symphony.pid"
PORT="${SYMPHONY_PORT:-4100}"
SMOKE_PORT="${SYMPHONY_SMOKE_PORT:-4101}"
KEYCHAIN_SERVICE="${LINEAR_KEYCHAIN_SERVICE:-dearme-linear-api-key}"
ACK_ARG="--i-understand-that-this-will-be-running-without-the-usual-guardrails"

usage() {
  cat <<'USAGE'
Usage: dearme-symphony <start|run|status|stop|smoke|rotate-logs>

Environment:
  LINEAR_API_KEY              Linear token; preferred for CI/temp shells.
  LINEAR_KEYCHAIN_SERVICE     macOS Keychain service name. Default: dearme-linear-api-key.
  SYMPHONY_PORT               Dashboard/API port for real Linear run. Default: 4100.
  SYMPHONY_SMOKE_PORT         Dashboard/API port for local smoke run. Default: 4101.

Log maintenance:
  dearme-symphony rotate-logs [--max-bytes N]
                               Archive and truncate launchd logs over the limit.
                               Default limit: 104857600 bytes.
USAGE
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

ensure_runtime() {
  [[ -x "$SYMPHONY_BIN" ]] || fail "Symphony CLI is not executable: $SYMPHONY_BIN"
  [[ -f "$WORKFLOW" ]] || fail "DearMe workflow is missing: $WORKFLOW"
  [[ -f "$SMOKE_WORKFLOW" ]] || fail "DearMe smoke workflow is missing: $SMOKE_WORKFLOW"
  mkdir -p "$LOGS_ROOT" "$RUN_DIR"
}

read_linear_token() {
  if [[ -n "${LINEAR_API_KEY:-}" ]]; then
    printf '%s' "$LINEAR_API_KEY"
    return 0
  fi

  if command -v security >/dev/null 2>&1; then
    local token
    token="$(security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null || true)"
    if [[ -n "$token" ]]; then
      printf '%s' "$token"
      return 0
    fi

    if [[ "$KEYCHAIN_SERVICE" != "LINEAR_API_KEY" ]]; then
      security find-generic-password -a "$USER" -s "LINEAR_API_KEY" -w 2>/dev/null || true
    fi
  fi
}

pid_is_running() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

current_pid() {
  [[ -f "$PID_FILE" ]] && tr -d '[:space:]' <"$PID_FILE" || true
}

listener_pid() {
  lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1 || true
}

persist_pid() {
  local pid="$1"
  [[ -n "$pid" ]] && printf '%s\n' "$pid" >"$PID_FILE"
}

api_state() {
  curl -fsS "http://127.0.0.1:$PORT/api/v1/state" 2>/dev/null
}

wait_for_api() {
  local port="$1"
  local pid="$2"
  local log_file="$3"

  for _ in $(seq 1 30); do
    if curl -fsS "http://127.0.0.1:$port/api/v1/state" >/tmp/dearme-symphony-state.json 2>/dev/null; then
      cat /tmp/dearme-symphony-state.json
      printf '\n'
      return 0
    fi

    if ! pid_is_running "$pid"; then
      printf 'Symphony exited before API was ready. Log tail:\n' >&2
      tail -n 80 "$log_file" >&2 || true
      return 1
    fi

    sleep 1
  done

  printf 'Symphony process is running but API did not become ready on port %s. Log tail:\n' "$port" >&2
  tail -n 80 "$log_file" >&2 || true
  return 1
}

run() {
  ensure_runtime

  local token
  token="$(read_linear_token)"
  if [[ -z "$token" ]]; then
    fail "Missing Linear token in LINEAR_API_KEY or Keychain service $KEYCHAIN_SERVICE"
  fi

  exec env LINEAR_API_KEY="$token" "$SYMPHONY_BIN" "$ACK_ARG" \
    --logs-root "$LOGS_ROOT" \
    --port "$PORT" \
    "$WORKFLOW"
}

start() {
  ensure_runtime

  local existing_pid
  existing_pid="$(current_pid)"
  if pid_is_running "$existing_pid"; then
    printf 'Symphony already running: pid=%s dashboard=http://127.0.0.1:%s/\n' "$existing_pid" "$PORT"
    return 0
  fi

  local existing_state
  if existing_state="$(api_state)"; then
    local actual_pid
    actual_pid="$(listener_pid)"
    persist_pid "$actual_pid"
    if [[ -n "$actual_pid" ]]; then
      printf 'Symphony already running: pid=%s dashboard=http://127.0.0.1:%s/\n' "$actual_pid" "$PORT"
    else
      printf 'Symphony API ready: dashboard=http://127.0.0.1:%s/\n' "$PORT"
    fi
    printf '%s\n' "$existing_state"
    return 0
  fi

  local token
  token="$(read_linear_token)"
  if [[ -z "$token" ]]; then
    cat >&2 <<EOF
Missing Linear token.

Store it in Keychain:
  security add-generic-password -a "\$USER" -s "$KEYCHAIN_SERVICE" -w '<LINEAR_API_KEY>' -U

Or run once with:
  LINEAR_API_KEY='<LINEAR_API_KEY>' $0 start
EOF
    exit 2
  fi

  local log_file
  log_file="$LOGS_ROOT/symphony-$(date +%Y%m%d-%H%M%S).log"
  ln -sf "$log_file" "$LOGS_ROOT/latest.log"

  nohup env LINEAR_API_KEY="$token" "$SYMPHONY_BIN" "$ACK_ARG" \
    --logs-root "$LOGS_ROOT" \
    --port "$PORT" \
    "$WORKFLOW" >"$log_file" 2>&1 </dev/null &
  local pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"
  unset token

  printf 'Starting Symphony: pid=%s dashboard=http://127.0.0.1:%s/ log=%s\n' "$pid" "$PORT" "$log_file"
  wait_for_api "$PORT" "$pid" "$log_file"
}

status() {
  ensure_runtime

  local state
  if state="$(api_state)"; then
    local actual_pid
    actual_pid="$(listener_pid)"
    persist_pid "$actual_pid"
    if [[ -n "$actual_pid" ]]; then
      printf 'Symphony running: pid=%s dashboard=http://127.0.0.1:%s/\n' "$actual_pid" "$PORT"
    else
      printf 'Symphony API ready: dashboard=http://127.0.0.1:%s/\n' "$PORT"
    fi
    printf '%s\n' "$state"
    return 0
  fi

  local pid
  pid="$(current_pid)"
  if pid_is_running "$pid"; then
    printf 'Symphony running: pid=%s dashboard=http://127.0.0.1:%s/\n' "$pid" "$PORT"
  else
    printf 'Symphony not running.\n'
    return 1
  fi

  curl -fsS "http://127.0.0.1:$PORT/api/v1/state" || true
  printf '\n'
}

stop() {
  mkdir -p "$RUN_DIR"

  local pid
  pid="$(current_pid)"
  if ! pid_is_running "$pid"; then
    pid="$(listener_pid)"
    persist_pid "$pid"
  fi

  if ! pid_is_running "$pid"; then
    printf 'Symphony not running.\n'
    rm -f "$PID_FILE"
    return 0
  fi

  kill "$pid" >/dev/null 2>&1 || true
  for _ in $(seq 1 10); do
    if ! pid_is_running "$pid"; then
      rm -f "$PID_FILE"
      printf 'Stopped Symphony pid=%s\n' "$pid"
      return 0
    fi
    sleep 1
  done

  kill -9 "$pid" >/dev/null 2>&1 || true
  rm -f "$PID_FILE"
  printf 'Force-stopped Symphony pid=%s\n' "$pid"
}

smoke() {
  ensure_runtime

  local log_file
  log_file="$LOGS_ROOT/symphony-smoke-$(date +%Y%m%d-%H%M%S).log"
  "$SYMPHONY_BIN" "$ACK_ARG" \
    --logs-root "$LOGS_ROOT" \
    --port "$SMOKE_PORT" \
    "$SMOKE_WORKFLOW" >"$log_file" 2>&1 &
  local pid=$!

  cleanup_smoke() {
    kill "$pid" >/dev/null 2>&1 || true
    wait "$pid" >/dev/null 2>&1 || true
  }
  trap cleanup_smoke EXIT

  printf 'Starting smoke Symphony: pid=%s dashboard=http://127.0.0.1:%s/ log=%s\n' "$pid" "$SMOKE_PORT" "$log_file"
  local wait_status=0
  wait_for_api "$SMOKE_PORT" "$pid" "$log_file" || wait_status=$?
  cleanup_smoke
  trap - EXIT
  return "$wait_status"
}

log_size_bytes() {
  local file="$1"
  wc -c <"$file" | tr -d '[:space:]'
}

rotate_one_log() {
  local file="$1"
  local max_bytes="$2"

  if [[ ! -f "$file" ]]; then
    printf 'Log missing, skipped: %s\n' "$file"
    return 0
  fi

  local bytes
  bytes="$(log_size_bytes "$file")"
  if (( bytes <= max_bytes )); then
    printf 'Log under limit, skipped: %s bytes=%s max=%s\n' "$file" "$bytes" "$max_bytes"
    return 0
  fi

  local archive_dir archive_file stamp
  archive_dir="$LOGS_ROOT/archive"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  archive_file="$archive_dir/$(basename "$file").$stamp.gz"
  mkdir -p "$archive_dir"

  gzip -c "$file" >"$archive_file"
  : >"$file"
  printf 'Rotated log: %s bytes=%s archive=%s\n' "$file" "$bytes" "$archive_file"
}

rotate_logs() {
  ensure_runtime

  local max_bytes=104857600
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-bytes)
        [[ $# -ge 2 ]] || fail "--max-bytes requires a value"
        max_bytes="$2"
        shift 2
        ;;
      --max-bytes=*)
        max_bytes="${1#--max-bytes=}"
        shift
        ;;
      *)
        fail "unknown rotate-logs argument: $1"
        ;;
    esac
  done

  [[ "$max_bytes" =~ ^[0-9]+$ ]] || fail "--max-bytes must be a non-negative integer"

  rotate_one_log "$LOGS_ROOT/launchd.out.log" "$max_bytes"
  rotate_one_log "$LOGS_ROOT/launchd.err.log" "$max_bytes"
}

case "${1:-}" in
  start) start ;;
  run) run ;;
  status) status ;;
  stop) stop ;;
  smoke) smoke ;;
  rotate-logs) shift; rotate_logs "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 64 ;;
esac
